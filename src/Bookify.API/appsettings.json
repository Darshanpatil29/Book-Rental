{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=bookify-db;Port=5432;Database=bookify;Username=bookify;Password=${DB_PASSWORD}",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "TrackQueryPerformance": false,
    "CommandTimeoutSeconds": 30,
    "UseLazyLoadingProxies": false,
    "MaxPoolSize": 20
  },
  "Authentication": {
    "Jwt": {
      "Secret": "${JWT_SECRET_MIN_32_CHARS_NEVER_COMMIT}",
      "AccessTokenExpiryMinutes": 15,
      "RefreshTokenExpiryDays": 7,
      "Issuer": "https://bookify.com",
      "Audience": "bookify-api",
      "ClockSkewSeconds": 0,
      "ValidateLifetime": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateIssuerSigningKey": true
    },
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET}",
      "RedirectUri": "https://bookify.com/api/v1/auth/google/callback",
      "Enabled": true,
      "Scopes": "openid email profile"
    },
    "TokenBlacklist": {
      "Enabled": true,
      "RedisKeyPrefix": "token:blacklist:",
      "RedisDatabase": 0
    }
  },
  "Redis": {
    "ConnectionString": "bookify-redis:6379",
    "DefaultCacheDurationSeconds": 3600
  },
  "CachingPolicy": {
    "SearchResultsCacheDuration": 3600,
    "ApartmentDetailsCacheDuration": 1800,
    "UserProfileCacheDuration": 900
  },
  "Jwt": {
    "Lifetime": 900,
    "RefreshTokenLifetime": 604800
  },
  "DetailedErrors": false,
  "IncludeExceptionDetails": false
}
