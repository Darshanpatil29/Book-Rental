{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=bookify-db;Port=5432;Database=bookify;Username=bookify;Password=${DB_PASSWORD}",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "TrackQueryPerformance": false,
    "CommandTimeoutSeconds": 30,
    "UseLazyLoadingProxies": false,
    "MaxPoolSize": 20
  },
  "Keycloak": {
    "Authority": "https://keycloak.example.com",
    "Audience": "bookify-api",
    "ClientId": "bookify-api",
    "ClientSecret": "${KEYCLOAK_CLIENT_SECRET}"
  },
  "Redis": {
    "ConnectionString": "bookify-redis:6379",
    "DefaultCacheDurationSeconds": 3600
  },
  "CachingPolicy": {
    "SearchResultsCacheDuration": 3600,
    "ApartmentDetailsCacheDuration": 1800,
    "UserProfileCacheDuration": 900
  },
  "Jwt": {
    "Lifetime": 900,
    "RefreshTokenLifetime": 604800
  },
  "DetailedErrors": false,
  "IncludeExceptionDetails": false
}
