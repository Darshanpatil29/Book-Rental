{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bookify;Username=bookify;Password=secure_password"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080",
    "Audience": "bookify-api",
    "ClientId": "bookify-api",
    "ClientSecret": "bookify-api-secret"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "CachingPolicy": {
    "SearchResultsCacheDuration": 300
  },
  "Jwt": {
    "Lifetime": 900
  },
  "DetailedErrors": true,
  "IncludeExceptionDetails": true
}
