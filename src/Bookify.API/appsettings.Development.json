{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=bookify;Username=bookify;Password=secure_password",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "TrackQueryPerformance": true,
    "CommandTimeoutSeconds": 30,
    "UseLazyLoadingProxies": false,
    "MaxPoolSize": 20
  },
  "Keycloak": {
    "Authority": "http://localhost:8080",
    "Audience": "bookify-api",
    "ClientId": "bookify-api",
    "ClientSecret": "bookify-api-secret"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultCacheDurationSeconds": 3600
  },
  "CachingPolicy": {
    "SearchResultsCacheDuration": 3600,
    "ApartmentDetailsCacheDuration": 1800,
    "UserProfileCacheDuration": 900
  },
  "Jwt": {
    "Lifetime": 900,
    "RefreshTokenLifetime": 604800
  },
  "DetailedErrors": true,
  "IncludeExceptionDetails": true
}
