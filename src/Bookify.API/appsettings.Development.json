{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=bookify;Username=bookify;Password=secure_password",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "TrackQueryPerformance": true,
    "CommandTimeoutSeconds": 30,
    "UseLazyLoadingProxies": false,
    "MaxPoolSize": 20
  },
  "Authentication": {
    "Jwt": {
      "Secret": "super-secret-key-min-32-characters-for-development-only",
      "AccessTokenExpiryMinutes": 15,
      "RefreshTokenExpiryDays": 7,
      "Issuer": "https://localhost:5000",
      "Audience": "bookify-api",
      "ClockSkewSeconds": 0,
      "ValidateLifetime": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateIssuerSigningKey": true
    },
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "RedirectUri": "https://localhost:5000/api/v1/auth/google/callback",
      "Enabled": true,
      "Scopes": "openid email profile"
    },
    "TokenBlacklist": {
      "Enabled": true,
      "RedisKeyPrefix": "token:blacklist:",
      "RedisDatabase": 0
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultCacheDurationSeconds": 3600
  },
  "CachingPolicy": {
    "SearchResultsCacheDuration": 3600,
    "ApartmentDetailsCacheDuration": 1800,
    "UserProfileCacheDuration": 900
  },
  "Jwt": {
    "Lifetime": 900,
    "RefreshTokenLifetime": 604800
  },
  "DetailedErrors": true,
  "IncludeExceptionDetails": true
}
