{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*.bookify.app",
  "ConnectionStrings": {
    "DefaultConnection": "User ID=bookify_prod;Password=REPLACE_WITH_SECURE_PASSWORD;Host=db-prod.bookify.app;Port=5432;Database=bookify;SSL Mode=Require;"
  },
  "Authentication": {
    "Jwt": {
      "Secret": "REPLACE_WITH_JWT_SECRET_MIN_32_CHARS",
      "AccessTokenExpiryMinutes": 15,
      "RefreshTokenExpiryDays": 7,
      "Issuer": "https://bookify.com",
      "Audience": "bookify-api-prod",
      "ClockSkewSeconds": 0,
      "ValidateLifetime": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateIssuerSigningKey": true
    },
    "Google": {
      "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET",
      "RedirectUri": "https://bookify.app/api/v1/auth/google/callback",
      "Enabled": true,
      "Scopes": "openid email profile"
    },
    "TokenBlacklist": {
      "Enabled": true,
      "RedisKeyPrefix": "token:blacklist:",
      "RedisDatabase": 0
    }
  },
  "Redis": {
    "ConnectionString": "redis-prod.bookify.app:6379,ssl=True,password=REPLACE_WITH_REDIS_PASSWORD"
  },
  "CachingPolicy": {
    "SearchResultsCacheDuration": 3600
  },
  "Jwt": {
    "Lifetime": 900
  },
  "DetailedErrors": false,
  "IncludeExceptionDetails": false,
  "EnableSensitiveDataLogging": false
}
